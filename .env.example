APP_ENV=local
APP_MODE=offline
AUTO_SEND=false
COMPOSE_PROJECT_NAME=ai-operations-assistant

EMAIL_ADAPTER=mock
LLM_ADAPTER=mock

SQLITE_PATH=.runtime/app.sqlite3

